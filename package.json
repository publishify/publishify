{
  "name": "publishify",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "check:language": "node scripts/check-language.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:language && pnpm build",
    "build": "pnpm --filter @publishify/client build",
    "dev": "pnpm --filter @publishify/client dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6"
  }
}
