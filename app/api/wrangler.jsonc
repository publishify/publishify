{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "publishify-app-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_HOSTS": "localhost",
    "PUBLIC_PAGES_ENABLED": "false",
    "GOOGLE_CLIENT_ID": "1030068899140-rrrs8rcrd2poro4vk5aggsrauqoncm2g.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/k/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKS",
        "class_name": "BookDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BookDO"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "publishify-app-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "publishify-snapshots-local"
    }
  ],
  "env": {
    "staging": {
      "name": "publishify-app-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "BOOKS",
            "class_name": "BookDO"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "publishify-app-staging",
          "database_id": "78683feb-a66e-46eb-aeba-9a08e80648cc",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SNAPSHOTS",
          "bucket_name": "publishify-snapshots-staging"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOWED_HOSTS": "staging.publishify.app",
        "PUBLIC_PAGES_ENABLED": "false",
        "GOOGLE_CLIENT_ID": "1030068899140-rrrs8rcrd2poro4vk5aggsrauqoncm2g.apps.googleusercontent.com"
      },
      "routes": [
        {
          "pattern": "staging.publishify.app",
          "custom_domain": true
        }
      ],
    },
    "production": {
      "name": "publishify-app",
      "durable_objects": {
        "bindings": [
          {
            "name": "BOOKS",
            "class_name": "BookDO"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "publishify-app-production",
          "database_id": "07f97692-0302-4b3c-a72a-75a9ab17775e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SNAPSHOTS",
          "bucket_name": "publishify-snapshots-production"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_HOSTS": "write.publishify.app",
        "RP_ID": "publishify.app",
        "PUBLIC_PAGES_ENABLED": "false",
        "GOOGLE_CLIENT_ID": "1030068899140-rrrs8rcrd2poro4vk5aggsrauqoncm2g.apps.googleusercontent.com"
      },
      "routes": [
        {
          "pattern": "write.publishify.app",
          "custom_domain": true
        }
      ]
    }
  }
}
